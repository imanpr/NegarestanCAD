<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>NegarestanCAD</AssemblyName>
    <RootNamespace>NegarestanCAD</RootNamespace>
    <Version>1.2.0</Version>
    <Authors>ایمان پرهیزکار — شهرداری بریس</Authors>
    <Company>شهرداری بریس</Company>
    <Copyright>© 1405 شهرداری بریس - ایمان پرهیزکار</Copyright>
    <Product>نگارستان کَد - سامانه حرفه‌ای نمایش DWG، نقشه ماهواره‌ای و نقشه‌برداری UTM</Product>
    <Description>اپلیکیشن ویندوزی فارسی برای نمایش نقشه‌های DWG/DXF و تصاویر ماهواره‌ای زمین، تبدیل UTM و مختصات جغرافیایی، محاسبه مساحت و پرینت رسمی دوگانه</Description>
    <ApplicationIcon>NegarestanCAD.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ACadSharp" Version="3.8.35" />
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- فونت وزیرمتن در صورت وجود در پوشه Fonts به صورت خودکار داخل فایل EXE جاسازی می‌شود -->
    <Resource Include="Fonts\*.ttf" Condition="Exists('Fonts')" />
  </ItemGroup>

</Project>
