<Window x:Class="NegarestanCAD.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تنظیمات برنامه — نگارستان کَد"
        Height="680" Width="620" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource VazirmatnFont}"
        Background="{StaticResource AppBgBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
            <StackPanel>
                <TextBlock Text="تنظیمات پیش‌فرض و شخصی‌سازی برنامه" FontSize="16" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,12"/>

                <!-- بخش ۱: مشخصات سازمان و لوگو برای چاپ رسمی -->
                <Border Background="{StaticResource CardBgBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,10" BorderBrush="#334155" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="مشخصات پیش‌فرض سازمان / شرکت (برای کارتوش پرینت رسمی)" FontWeight="Bold" FontSize="12.5" Foreground="#38BDF8" Margin="0,0,0,8"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="نام پیش‌فرض سازمان / شرکت" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3"/>
                                <TextBox x:Name="TxtOrgName"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="شماره پروانه / شناسه پیش‌فرض" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3"/>
                                <TextBox x:Name="TxtLicense"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="لوگوی پیش‌فرض سازمان (در تمام پرینت‌ها به‌صورت خودکار لود می‌شود)" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="46" Height="46" CornerRadius="6" Background="#0F172A" BorderBrush="#475569" BorderThickness="1" Margin="0,0,8,0">
                                <Image x:Name="ImgLogoPreview" Stretch="Uniform" Margin="3"/>
                            </Border>
                            <TextBox x:Name="TxtLogoPath" Grid.Column="1" IsReadOnly="True" FlowDirection="LeftToRight" VerticalAlignment="Center"/>
                            <Button Grid.Column="2" Content="انتخاب لوگو" Click="BtnBrowseLogo_Click" Margin="6,0,4,0" VerticalAlignment="Center"/>
                            <Button Grid.Column="3" Content="حذف" Click="BtnClearLogo_Click" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- بخش ۲: فایل DWG پیش‌فرض و تم بوم -->
                <Border Background="{StaticResource CardBgBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,10" BorderBrush="#334155" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="تنظیمات شروع برنامه و ظاهر بوم CAD" FontWeight="Bold" FontSize="12.5" Foreground="#38BDF8" Margin="0,0,0,8"/>

                        <TextBlock Text="فایل نقشه DWG / DXF پیش‌فرض (در صورت انتخاب، با باز شدن برنامه خودکار لود می‌شود)" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtStartupCadPath" Grid.Column="0" IsReadOnly="True" FlowDirection="LeftToRight"/>
                            <Button Grid.Column="1" Content="انتخاب فایل DWG" Click="BtnBrowseCad_Click" Margin="6,0,4,0"/>
                            <Button Grid.Column="2" Content="خالی کردن" Click="BtnClearCad_Click"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="حالت پیش‌فرض رنگ بوم CAD" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3"/>
                                <ComboBox x:Name="CmbCanvasTheme">
                                    <ComboBoxItem Content="بوم تیره (Dark — استاندارد اتوکد)"/>
                                    <ComboBoxItem Content="بوم روشن (Light)"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="حالت نمایش پیش‌فرض هنگام شروع" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3"/>
                                <ComboBox x:Name="CmbViewMode">
                                    <ComboBoxItem Content="هر دو نقشه همزمان (CAD + ماهواره)"/>
                                    <ComboBoxItem Content="فقط نقشه CAD"/>
                                    <ComboBoxItem Content="فقط نقشه ماهواره‌ای"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- بخش ۳: نقشه ماهواره‌ای، نقطه شروع و کش -->
                <Border Background="{StaticResource CardBgBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,10" BorderBrush="#334155" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="تنظیمات نقشه ماهواره‌ای و موقعیت شروع پیش‌فرض" FontWeight="Bold" FontSize="12.5" Foreground="#38BDF8" Margin="0,0,0,8"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.4*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="سرویس‌دهنده تصاویر ماهواره‌ای" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3"/>
                                <ComboBox x:Name="CmbSatProvider">
                                    <ComboBoxItem Content="Google ماهواره + برچسب فارسی (پیشنهادی)"/>
                                    <ComboBoxItem Content="Google ماهواره خالص"/>
                                    <ComboBoxItem Content="Esri World Imagery (ماهواره)"/>
                                    <ComboBoxItem Content="OpenStreetMap (خیابان)"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="زون پیش‌فرض UTM" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3"/>
                                <ComboBox x:Name="CmbDefaultZone"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="عرض جغرافیایی شروع (Lat)" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3"/>
                                <TextBox x:Name="TxtDefaultLat" FlowDirection="LeftToRight"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="طول جغرافیایی شروع (Lon)" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3"/>
                                <TextBox x:Name="TxtDefaultLon" FlowDirection="LeftToRight"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="زوم شروع" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3"/>
                                <TextBox x:Name="TxtDefaultZoom" FlowDirection="LeftToRight"/>
                            </StackPanel>
                        </Grid>

                        <DockPanel Margin="0,4,0,0">
                            <TextBlock x:Name="TxtCacheInfo" Text="حجم کش تصاویر ماهواره‌ای: 0 MB" VerticalAlignment="Center" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"/>
                            <Button Content="🗑️ پاک‌سازی کش تصاویر" Click="BtnClearCache_Click" DockPanel.Dock="Left" HorizontalAlignment="Left" Padding="10,4" FontSize="11"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- دکمه‌های ذخیره و انصراف -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,12,0,0">
            <Button Content="💾 ذخیره تنظیمات" Style="{StaticResource SuccessButtonStyle}" Width="135" Height="34" Click="BtnSave_Click" Margin="0,0,8,0"/>
            <Button Content="انصراف" Width="90" Height="34" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
