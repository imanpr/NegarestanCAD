<Window x:Class="NegarestanCAD.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:NegarestanCAD.Controls"
        Title="نگارستان کَد v1.2.0 — سامانه نمایش DWG، نقشه ماهواره‌ای و نقشه‌برداری UTM | شهرداری بریس"
        Height="860" Width="1500" MinHeight="680" MinWidth="1120"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource VazirmatnFont}"
        Background="{StaticResource AppBgBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        Loaded="MainWindow_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- نوار ابزار اصلی بالا -->
        <Border Grid.Row="0" Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="0,0,0,1" Padding="10,6">
            <StackPanel>
                <!-- ردیف اول: فایل، ایمپورت/اکسپورت، پرینت و تنظیمات -->
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,5">
                    <Button Content="📂 باز کردن DWG / DXF" Style="{StaticResource PrimaryButtonStyle}" Click="BtnOpenCad_Click" Margin="0,0,5,0" ToolTip="Ctrl+O"/>
                    <Button Content="💾 ذخیره پروژه" Click="BtnSaveProject_Click" Margin="0,0,4,0" ToolTip="Ctrl+S"/>
                    <Button Content="📁 باز کردن پروژه" Click="BtnLoadProject_Click" Margin="0,0,8,0"/>

                    <Border Width="1" Background="#475569" Margin="2,4,8,4"/>

                    <Button Content="📥 ایمپورت نقاط" Click="BtnImportPoints_Click" Margin="0,0,4,0"/>
                    <Button Content="📤 Excel" Click="BtnExportExcel_Click" Margin="0,0,4,0"/>
                    <Button Content="📤 CSV" Click="BtnExportCsv_Click" Margin="0,0,4,0"/>
                    <Button Content="📐 DXF" Click="BtnExportDxf_Click" Margin="0,0,4,0"/>
                    <Button Content="🌍 KML / KMZ" Click="BtnExportKml_Click" Margin="0,0,8,0"/>

                    <Border Width="1" Background="#475569" Margin="2,4,8,4"/>

                    <Button Content="🖨️ پرینت رسمی و کارتوش" Style="{StaticResource SuccessButtonStyle}" Click="BtnOfficialPrint_Click" Margin="0,0,8,0" ToolTip="Ctrl+P"/>

                    <Border Width="1" Background="#475569" Margin="2,4,8,4"/>

                    <Button Content="⚙️ تنظیمات" Click="BtnSettings_Click" Margin="0,0,4,0"/>
                    <Button Content="ℹ️ درباره ما" Click="BtnAbout_Click"/>
                </WrapPanel>

                <!-- ردیف دوم: حالت نمایش (CAD / ماهواره / هر دو) + ابزارهای تعاملی نقشه -->
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- کنترل سه حالته نمایش نقشه -->
                    <Border Background="#0F172A" CornerRadius="6" Padding="3" BorderBrush="#334155" BorderThickness="1" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnViewCadOnly" Content="📐 فقط نقشه CAD" Click="BtnViewCadOnly_Click" Padding="9,3" FontSize="11.5" Margin="0,0,3,0"/>
                            <Button x:Name="BtnViewSatOnly" Content="🌍 فقط نقشه زمین" Click="BtnViewSatOnly_Click" Padding="9,3" FontSize="11.5" Margin="0,0,3,0"/>
                            <Button x:Name="BtnViewBoth" Content="◫ هر دو همزمان" Click="BtnViewBoth_Click" Padding="9,3" FontSize="11.5"/>
                        </StackPanel>
                    </Border>

                    <ComboBox x:Name="CmbSatProviderToolbar" Width="185" Margin="0,0,6,0" SelectionChanged="CmbSatProviderToolbar_SelectionChanged" ToolTip="انتخاب سرویس‌دهنده تصاویر ماهواره‌ای">
                        <ComboBoxItem Content="Google ماهواره + برچسب فارسی" IsSelected="True"/>
                        <ComboBoxItem Content="Google ماهواره خالص"/>
                        <ComboBoxItem Content="Esri World Imagery"/>
                        <ComboBoxItem Content="OpenStreetMap"/>
                    </ComboBox>

                    <CheckBox x:Name="ChkSyncViewports" Content="🔗 همگام‌سازی حرکت و زوم" IsChecked="True" VerticalAlignment="Center" Margin="2,0,10,0" Checked="ChkSyncViewports_Changed" Unchecked="ChkSyncViewports_Changed"/>

                    <Border Width="1" Background="#475569" Margin="2,4,8,4"/>

                    <Button x:Name="BtnToolPan" Content="✋ جابجایی" Click="BtnToolPan_Click" Margin="0,0,4,0" Padding="8,4" FontSize="11.5"/>
                    <Button x:Name="BtnToolAddPoint" Content="📍 ثبت نقطه با کلیک" Click="BtnToolAddPoint_Click" Margin="0,0,4,0" Padding="8,4" FontSize="11.5"/>
                    <Button x:Name="BtnToolRuler" Content="📏 خط‌کش" Click="BtnToolRuler_Click" Margin="0,0,4,0" Padding="8,4" FontSize="11.5"/>
                    <Button x:Name="BtnToolAngle" Content="📐 زاویه‌سنج" Click="BtnToolAngle_Click" Margin="0,0,8,0" Padding="8,4" FontSize="11.5"/>

                    <Button Content="🔍 کل نقشه" Click="BtnZoomExtents_Click" Margin="0,0,4,0" Padding="8,4" FontSize="11.5"/>
                    <Button Content="🎯 زوم محدوده" Click="BtnZoomPoints_Click" Margin="0,0,4,0" Padding="8,4" FontSize="11.5"/>
                    <Button x:Name="BtnToggleTheme" Content="☀️ بوم روشن" Click="BtnToggleTheme_Click" Padding="8,4" FontSize="11.5"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- بدنه سه‌ستونه اصلی -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="395" MinWidth="335"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="255" MinWidth="205"/>
            </Grid.ColumnDefinitions>

            <!-- پنل راست: ورود و تبدیل مختصات + لیست نقاط + محاسبات مساحت و اضلاع -->
            <Border Grid.Column="0" Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                    <StackPanel>
                        <!-- کارت ۱: ورود و تبدیل UTM ↔ Lat/Lon -->
                        <Border Background="{StaticResource CardBgBrush}" CornerRadius="8" Padding="10" Margin="0,0,0,10" BorderBrush="#334155" BorderThickness="1">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="ورود و تبدیل مختصات (UTM ↔ Lat/Lon)" FontWeight="Bold" FontSize="13" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" HorizontalAlignment="Left">
                                        <TextBlock Text="زون:" VerticalAlignment="Center" Margin="6,0,4,0" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"/>
                                        <ComboBox x:Name="CmbUtmZone" Width="60" SelectionChanged="CmbUtmZone_SelectionChanged"/>
                                        <ComboBox x:Name="CmbHemisphere" Width="48" Margin="4,0,0,0" SelectionChanged="CmbUtmZone_SelectionChanged">
                                            <ComboBoxItem Content="N" IsSelected="True"/>
                                            <ComboBoxItem Content="S"/>
                                        </ComboBox>
                                    </StackPanel>
                                </DockPanel>

                                <!-- ردیف UTM -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="X شرقی (Easting - m)" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                        <TextBox x:Name="TxtUtmX" FlowDirection="LeftToRight" ToolTip="مثال: 316715.368"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Y شمالی (Northing - m)" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                        <TextBox x:Name="TxtUtmY" FlowDirection="LeftToRight" ToolTip="مثال: 2781695.808"/>
                                    </StackPanel>
                                </Grid>

                                <!-- دکمه‌های تبدیل دوطرفه -->
                                <Grid Margin="0,2,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="⬇ تبدیل UTM به Lat/Lon" Click="BtnConvertUtmToLatLon_Click" FontSize="11.5"/>
                                    <Button Grid.Column="2" Content="⬆ تبدیل Lat/Lon به UTM" Click="BtnConvertLatLonToUtm_Click" FontSize="11.5"/>
                                </Grid>

                                <!-- ردیف Lat / Lon -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="عرض جغرافیایی (Lat / DMS)" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                        <TextBox x:Name="TxtLat" FlowDirection="LeftToRight" ToolTip="مثال: 25.135843"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="طول جغرافیایی (Lon / DMS)" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                        <TextBox x:Name="TxtLon" FlowDirection="LeftToRight" ToolTip="مثال: 61.188676"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock x:Name="TxtDmsPreview" Text="" FontSize="10.5" Foreground="#94A3B8" FlowDirection="LeftToRight" Margin="0,2,0,6"/>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtPointDesc" Grid.Column="0" ToolTip="توضیحات اختیاری نقطه"/>
                                    <Button Grid.Column="2" Content="🔍 برو به نقطه" Click="BtnGoToCoord_Click" ToolTip="رفتن هر دو نقشه به مختصات واردشده" Padding="8,5"/>
                                    <Button Grid.Column="4" Content="➕ افزودن نقطه" Style="{StaticResource PrimaryButtonStyle}" Click="BtnAddPoint_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- کارت ۲: لیست نقاط محدوده با Drag & Drop -->
                        <Border Background="{StaticResource CardBgBrush}" CornerRadius="8" Padding="10" Margin="0,0,0,10" BorderBrush="#334155" BorderThickness="1">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="نقاط محدوده (ترتیب با درگ / جابجایی روی نقشه)" FontWeight="Bold" FontSize="12" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtPointCount" Text="0 نقطه" DockPanel.Dock="Left" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                </DockPanel>

                                <Border x:Name="BannerSelfIntersect" Visibility="Collapsed" Background="#7F1D1D" CornerRadius="6" Padding="8,5" Margin="0,0,0,6">
                                    <TextBlock Text="⚠️ هشدار: اضلاع محدوده همدیگر را قطع کرده‌اند! با کشیدن نقاط یا دکمه «مرتب‌سازی ساعتگرد» ترتیب را اصلاح کنید."
                                               FontSize="11" TextWrapping="Wrap" Foreground="#FECACA"/>
                                </Border>

                                <ListView x:Name="LstPoints" Height="185"
                                          Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155"
                                          AllowDrop="True"
                                          PreviewMouseLeftButtonDown="LstPoints_PreviewMouseLeftButtonDown"
                                          PreviewMouseMove="LstPoints_PreviewMouseMove"
                                          Drop="LstPoints_Drop"
                                          SelectionChanged="LstPoints_SelectionChanged">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="گوشه" Width="46" DisplayMemberBinding="{Binding Label}"/>
                                            <GridViewColumn Header="X (Easting)" Width="105" DisplayMemberBinding="{Binding Easting, StringFormat={}{0:F3}}"/>
                                            <GridViewColumn Header="Y (Northing)" Width="112" DisplayMemberBinding="{Binding Northing, StringFormat={}{0:F3}}"/>
                                            <GridViewColumn Header="زون" Width="44" DisplayMemberBinding="{Binding ZoneDisplay}"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>

                                <WrapPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="▲ بالا" Click="BtnMoveUp_Click" Margin="0,0,4,4" Padding="8,4" FontSize="11"/>
                                    <Button Content="▼ پایین" Click="BtnMoveDown_Click" Margin="0,0,4,4" Padding="8,4" FontSize="11"/>
                                    <Button Content="🔄 مرتب‌سازی ساعتگرد" Click="BtnSortClockwise_Click" Margin="0,0,4,4" Padding="8,4" FontSize="11"/>
                                    <Button Content="🗑️ حذف انتخاب‌شده" Style="{StaticResource DangerButtonStyle}" Click="BtnDeletePoint_Click" Margin="0,0,4,4" Padding="8,4" FontSize="11"/>
                                    <Button Content="پاک‌سازی همه" Click="BtnClearPoints_Click" Margin="0,0,0,4" Padding="8,4" FontSize="11"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- کارت ۳: خلاصه متراژ، مساحت و جدول طول اضلاع -->
                        <Border Background="{StaticResource CardBgBrush}" CornerRadius="8" Padding="10" BorderBrush="#334155" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="خلاصه مساحت و طول اضلاع" FontWeight="Bold" FontSize="12.5" Foreground="#38BDF8" Margin="0,0,0,8"/>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#0F172A" CornerRadius="6" Padding="8" BorderBrush="#0284C7" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="مساحت واقعی زمین" FontSize="10.5" Foreground="#94A3B8"/>
                                            <TextBlock x:Name="TxtGroundArea" Text="0.00 m²" FontSize="14" FontWeight="Bold" Foreground="#38BDF8" FlowDirection="LeftToRight" HorizontalAlignment="Right"/>
                                            <TextBlock x:Name="TxtGroundHectares" Text="0.0000 هکتار" FontSize="10.5" Foreground="#CBD5E1"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Background="#0F172A" CornerRadius="6" Padding="8" BorderBrush="#334155" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="محیط کل محدوده" FontSize="10.5" Foreground="#94A3B8"/>
                                            <TextBlock x:Name="TxtPerimeter" Text="0.00 m" FontSize="14" FontWeight="Bold" Foreground="#10B981" FlowDirection="LeftToRight" HorizontalAlignment="Right"/>
                                            <TextBlock x:Name="TxtPlanarAreaSub" Text="مسطح UTM: 0.00 m²" FontSize="10" Foreground="#94A3B8"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <TextBlock x:Name="TxtScaleFactorInfo" Text="ضریب مقیاس UTM: 1.000000" FontSize="10.5" Foreground="#94A3B8" Margin="0,0,0,6"/>

                                <ListView x:Name="LstEdges" Height="145" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="ضلع" Width="74" DisplayMemberBinding="{Binding EdgeName}"/>
                                            <GridViewColumn Header="فاصله واقعی (m)" Width="105" DisplayMemberBinding="{Binding GroundLengthMeters, StringFormat={}{0:N2}}"/>
                                            <GridViewColumn Header="فاصله مسطح (m)" Width="105" DisplayMemberBinding="{Binding PlanarLengthMeters, StringFormat={}{0:N2}}"/>
                                            <GridViewColumn Header="آزیموت" Width="62" DisplayMemberBinding="{Binding AzimuthDegrees, StringFormat={}{0:F1}°}"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#334155"/>

            <!-- فضای مرکزی دوگانه: نقشه CAD + اسپلیتر قابل تغییر عرض + نقشه ماهواره‌ای زمین -->
            <Grid Grid.Column="2">
                <Grid x:Name="MapSplitGrid" FlowDirection="LeftToRight">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ColCad" Width="*"/>
                        <ColumnDefinition x:Name="ColMapSplitter" Width="5"/>
                        <ColumnDefinition x:Name="ColSat" Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- پنل نقشه CAD -->
                    <Grid x:Name="CadContainer" Grid.Column="0">
                        <ctrl:CadCanvasControl x:Name="CadCanvas"/>
                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" Padding="8,3"
                                Background="#CC0F172A" CornerRadius="5" BorderBrush="#38BDF8" BorderThickness="0.8">
                            <TextBlock Text="📐 نقشه کدی (CAD / UTM)" FontSize="11" Foreground="#38BDF8" FontWeight="SemiBold" FlowDirection="RightToLeft"/>
                        </Border>
                    </Grid>

                    <!-- اسپلیتر قابل تغییر عرض بین CAD و ماهواره -->
                    <GridSplitter x:Name="MapGridSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                                  Background="#334155" Cursor="SizeWE" ToolTip="برای تغییر عرض نقشه CAD و ماهواره بکشید"/>

                    <!-- پنل نقشه ماهواره‌ای زمین -->
                    <Grid x:Name="SatContainer" Grid.Column="2">
                        <ctrl:SatelliteMapControl x:Name="SatelliteMap"/>
                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" Padding="8,3"
                                Background="#CC0F172A" CornerRadius="5" BorderBrush="#10B981" BorderThickness="0.8">
                            <TextBlock Text="🌍 تصویر ماهواره‌ای زمین" FontSize="11" Foreground="#34D399" FontWeight="SemiBold" FlowDirection="RightToLeft"/>
                        </Border>
                    </Grid>
                </Grid>

                <!-- نشانگر ابزار فعال در گوشه بالا-راست فضای نقشه -->
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" Padding="10,5"
                        Background="#CC0F172A" CornerRadius="6" BorderBrush="#334155" BorderThickness="1" IsHitTestVisible="False">
                    <TextBlock x:Name="TxtActiveToolHint" Text="ابزار فعال: جابجایی نقشه" FontSize="11.5" Foreground="#E2E8F0"/>
                </Border>

                <!-- کادر ورود سریع نقطه با شورت‌کات + -->
                <Border x:Name="QuickCoordBar" Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18"
                        Background="#EE0F172A" CornerRadius="8" Padding="12,8"
                        BorderBrush="#38BDF8" BorderThickness="1.5">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtQuickPointLabel" Text="ورود سریع نقطه A:"
                                   FontWeight="Bold" FontSize="12.5" Foreground="#38BDF8"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="TxtQuickCoord" Width="260" FontSize="13"
                                 FlowDirection="LeftToRight"
                                 KeyDown="TxtQuickCoord_KeyDown"
                                 ToolTip="مثال: 316715.368, 2781695.808 یا 25.1358, 61.1886"/>
                        <TextBlock Text="X, Y  (Enter = ثبت | Esc = بستن)"
                                   FontSize="10.5" Foreground="#94A3B8"
                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>
                </Border>

                <!-- لایه بارگذاری هنگام خواندن فایل‌های DWG سنگین -->
                <Border x:Name="OverlayLoading" Visibility="Collapsed" Background="#AA0F172A">
                    <Border Background="#1E293B" CornerRadius="10" Padding="24,16" HorizontalAlignment="Center" VerticalAlignment="Center"
                            BorderBrush="#38BDF8" BorderThickness="1.2">
                        <StackPanel>
                            <TextBlock x:Name="TxtLoadingMessage" Text="در حال خواندن و پردازش فایل DWG..." FontSize="14" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center"/>
                            <ProgressBar IsIndeterminate="True" Width="260" Height="6" Margin="0,12,0,0" Foreground="#38BDF8" Background="#0F172A"/>
                        </StackPanel>
                    </Border>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch" Background="#334155"/>

            <!-- پنل چپ: مدیریت لایه‌های DWG و تنظیمات نمایش -->
            <Border Grid.Column="4" Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1,0,0,0" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="مدیریت لایه‌های نقشه (DWG)" FontWeight="Bold" FontSize="12.5" Foreground="#38BDF8" Margin="0,0,0,6"/>
                        <TextBlock x:Name="TxtLoadedCadFile" Text="هیچ فایل نقشه‌ای باز نشده است" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="همه روشن" Click="BtnAllLayersOn_Click" FontSize="11" Padding="6,3"/>
                            <Button Grid.Column="2" Content="همه خاموش" Click="BtnAllLayersOff_Click" FontSize="11" Padding="6,3"/>
                        </Grid>
                        <TextBox x:Name="TxtLayerSearch" TextChanged="TxtLayerSearch_TextChanged" ToolTip="جستجوی نام لایه..."/>
                    </StackPanel>

                    <ListBox x:Name="LstLayers" Grid.Row="1" Background="#0F172A" BorderBrush="#334155" Foreground="#F8FAFC">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="2">
                                    <CheckBox IsChecked="{Binding IsVisible}" Click="ChkLayerVisible_Click" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <Border Width="11" Height="11" CornerRadius="2" Background="{Binding ColorHex}" BorderBrush="#64748B" BorderThickness="0.6" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding EntityCount, StringFormat=' ({0})'}" VerticalAlignment="Center" FontSize="10.5" Foreground="#94A3B8" DockPanel.Dock="Left"/>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- تنظیمات سریع مهندسی -->
                    <Border Grid.Row="2" Background="{StaticResource CardBgBrush}" CornerRadius="8" Padding="8" Margin="0,10,0,0" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="تنظیمات نمایش و دقت" FontWeight="Bold" FontSize="12" Foreground="#38BDF8" Margin="0,0,0,6"/>
                            <CheckBox x:Name="ChkEnableSnap" Content="اسنپ دقیق روی گوشه‌ها (OSNAP)" IsChecked="True" Checked="SettingChanged" Unchecked="SettingChanged" Margin="0,0,0,4"/>
                            <CheckBox x:Name="ChkShowCadUnderlay" Content="نمایش نقشه DWG زیر کار" IsChecked="True" Checked="SettingChanged" Unchecked="SettingChanged" Margin="0,0,0,4"/>
                            <CheckBox x:Name="ChkShowDistances" Content="نمایش فاصله بین نقاط روی نقشه" IsChecked="True" Checked="SettingChanged" Unchecked="SettingChanged" Margin="0,0,0,4"/>
                            <CheckBox x:Name="ChkShowAngles" Content="نمایش زوایای داخلی گوشه‌ها" IsChecked="True" Checked="SettingChanged" Unchecked="SettingChanged" Margin="0,0,0,4"/>
                            <CheckBox x:Name="ChkUseGroundArea" Content="مساحت و طول واقعی زمین (ضریب UTM)" IsChecked="True" Checked="SettingChanged" Unchecked="SettingChanged" Margin="0,0,0,4"/>
                            <CheckBox x:Name="ChkFixShx" Content="اصلاح متون فارسی SHX قدیمی" IsChecked="True" Checked="SettingChanged" Unchecked="SettingChanged" Margin="0,0,0,4"/>
                            <CheckBox x:Name="ChkPersianDigits" Content="نمایش ارقام به صورت فارسی (۱۲۳)" IsChecked="False" Checked="SettingChanged" Unchecked="SettingChanged"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- نوار وضعیت پایین -->
        <Border Grid.Row="2" Background="#0B1120" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="0,1,0,0" Padding="12,5">
            <DockPanel>
                <TextBlock x:Name="TxtStatusCoordsUtm" Text="UTM: X = 0.000 , Y = 0.000" FontSize="11.5" Foreground="#38BDF8" FlowDirection="LeftToRight" Margin="0,0,18,0"/>
                <TextBlock x:Name="TxtStatusCoordsGeo" Text="Lat/Lon: 25.135843 , 61.188676" FontSize="11.5" Foreground="#A7F3D0" FlowDirection="LeftToRight" Margin="0,0,18,0"/>
                <TextBlock x:Name="TxtStatusSnap" Text="" FontSize="11.5" Foreground="#FACC15" Margin="0,0,18,0"/>
                <TextBlock x:Name="TxtStatusMeasure" Text="" FontSize="11.5" Foreground="#4ADE80" DockPanel.Dock="Left" HorizontalAlignment="Left"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
