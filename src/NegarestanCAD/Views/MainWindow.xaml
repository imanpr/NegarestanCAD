<Window x:Class="NegarestanCAD.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:NegarestanCAD.Controls"
        Title="نگارستان کَد — سامانه حرفه‌ای نمایش DWG و نقشه‌برداری UTM | شهرداری بریس"
        Height="860" Width="1460" MinHeight="680" MinWidth="1120"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource VazirmatnFont}"
        Background="{StaticResource AppBgBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- نوار ابزار اصلی بالا -->
        <Border Grid.Row="0" Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="0,0,0,1" Padding="10,7">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="📂 باز کردن DWG / DXF" Style="{StaticResource PrimaryButtonStyle}" Click="BtnOpenCad_Click" Margin="0,0,6,0"/>
                <Button Content="💾 ذخیره پروژه" Click="BtnSaveProject_Click" Margin="0,0,4,0"/>
                <Button Content="📁 باز کردن پروژه" Click="BtnLoadProject_Click" Margin="0,0,8,0"/>

                <Border Width="1" Background="#475569" Margin="2,4,8,4"/>

                <Button Content="📥 ایمپورت نقاط (Excel/CSV)" Click="BtnImportPoints_Click" Margin="0,0,4,0"/>
                <Button Content="📤 خروجی Excel" Click="BtnExportExcel_Click" Margin="0,0,4,0"/>
                <Button Content="📤 خروجی CSV" Click="BtnExportCsv_Click" Margin="0,0,4,0"/>
                <Button Content="📐 خروجی DXF" Click="BtnExportDxf_Click" Margin="0,0,4,0"/>
                <Button Content="🌍 خروجی KML / KMZ" Click="BtnExportKml_Click" Margin="0,0,8,0"/>

                <Border Width="1" Background="#475569" Margin="2,4,8,4"/>

                <Button Content="🖨️ پرینت رسمی و کارتوش" Style="{StaticResource SuccessButtonStyle}" Click="BtnOfficialPrint_Click" Margin="0,0,8,0"/>

                <Border Width="1" Background="#475569" Margin="2,4,8,4"/>

                <Button x:Name="BtnToolPan" Content="✋ جابجایی" Click="BtnToolPan_Click" Margin="0,0,4,0"/>
                <Button x:Name="BtnToolAddPoint" Content="📍 ثبت نقطه با کلیک" Click="BtnToolAddPoint_Click" Margin="0,0,4,0"/>
                <Button x:Name="BtnToolRuler" Content="📏 خط‌کش" Click="BtnToolRuler_Click" Margin="0,0,4,0"/>
                <Button x:Name="BtnToolAngle" Content="📐 زاویه‌سنج" Click="BtnToolAngle_Click" Margin="0,0,8,0"/>

                <Button Content="🔍 کل نقشه" Click="BtnZoomExtents_Click" Margin="0,0,4,0"/>
                <Button Content="🎯 زوم محدوده" Click="BtnZoomPoints_Click" Margin="0,0,4,0"/>
                <Button x:Name="BtnToggleTheme" Content="☀️ بوم روشن" Click="BtnToggleTheme_Click" Margin="0,0,4,0"/>
                <Button Content="ℹ️ درباره ما" Click="BtnAbout_Click"/>
            </WrapPanel>
        </Border>

        <!-- بدنه سه‌ستونه اصلی -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400" MinWidth="340"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="260" MinWidth="210"/>
            </Grid.ColumnDefinitions>

            <!-- پنل راست: ورود و تبدیل مختصات + لیست نقاط + محاسبات مساحت و اضلاع -->
            <Border Grid.Column="0" Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                    <StackPanel>
                        <!-- کارت ۱: ورود و تبدیل UTM ↔ Lat/Lon -->
                        <Border Background="{StaticResource CardBgBrush}" CornerRadius="8" Padding="10" Margin="0,0,0,10" BorderBrush="#334155" BorderThickness="1">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="ورود و تبدیل مختصات (UTM ↔ Lat/Lon)" FontWeight="Bold" FontSize="13" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" HorizontalAlignment="Left">
                                        <TextBlock Text="زون:" VerticalAlignment="Center" Margin="6,0,4,0" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"/>
                                        <ComboBox x:Name="CmbUtmZone" Width="62" SelectionChanged="CmbUtmZone_SelectionChanged"/>
                                        <ComboBox x:Name="CmbHemisphere" Width="50" Margin="4,0,0,0" SelectionChanged="CmbUtmZone_SelectionChanged">
                                            <ComboBoxItem Content="N" IsSelected="True"/>
                                            <ComboBoxItem Content="S"/>
                                        </ComboBox>
                                    </StackPanel>
                                </DockPanel>

                                <!-- ردیف UTM -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="X شرقی (Easting - m)" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                        <TextBox x:Name="TxtUtmX" FlowDirection="LeftToRight" ToolTip="مثال: 654321.500"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Y شمالی (Northing - m)" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                        <TextBox x:Name="TxtUtmY" FlowDirection="LeftToRight" ToolTip="مثال: 3987654.250"/>
                                    </StackPanel>
                                </Grid>

                                <!-- دکمه‌های تبدیل دوطرفه -->
                                <Grid Margin="0,2,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="⬇ تبدیل UTM به Lat/Lon" Click="BtnConvertUtmToLatLon_Click" FontSize="11.5"/>
                                    <Button Grid.Column="2" Content="⬆ تبدیل Lat/Lon به UTM" Click="BtnConvertLatLonToUtm_Click" FontSize="11.5"/>
                                </Grid>

                                <!-- ردیف Lat / Lon -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="عرض جغرافیایی (Lat / DMS)" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                        <TextBox x:Name="TxtLat" FlowDirection="LeftToRight" ToolTip="مثال: 36.2972 یا 36° 17' 50&quot; N"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="طول جغرافیایی (Lon / DMS)" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                        <TextBox x:Name="TxtLon" FlowDirection="LeftToRight" ToolTip="مثال: 59.6067 یا 59° 36' 24&quot; E"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock x:Name="TxtDmsPreview" Text="" FontSize="10.5" Foreground="#94A3B8" FlowDirection="LeftToRight" Margin="0,2,0,6"/>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtPointDesc" Grid.Column="0" ToolTip="توضیحات اختیاری نقطه (مثلاً گوشه شمال‌شرقی)"/>
                                    <Button Grid.Column="2" Content="➕ افزودن نقطه به نقشه" Style="{StaticResource PrimaryButtonStyle}" Click="BtnAddPoint_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- کارت ۲: لیست نقاط محدوده با Drag & Drop -->
                        <Border Background="{StaticResource CardBgBrush}" CornerRadius="8" Padding="10" Margin="0,0,0,10" BorderBrush="#334155" BorderThickness="1">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="نقاط محدوده (برای تغییر ترتیب بکشید)" FontWeight="Bold" FontSize="12.5" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtPointCount" Text="0 نقطه" DockPanel.Dock="Left" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                </DockPanel>

                                <Border x:Name="BannerSelfIntersect" Visibility="Collapsed" Background="#7F1D1D" CornerRadius="6" Padding="8,5" Margin="0,0,0,6">
                                    <TextBlock Text="⚠️ هشدار: اضلاع محدوده همدیگر را قطع کرده‌اند! با کشیدن نقاط یا دکمه «مرتب‌سازی ساعتگرد» ترتیب را اصلاح کنید."
                                               FontSize="11" TextWrapping="Wrap" Foreground="#FECACA"/>
                                </Border>

                                <ListView x:Name="LstPoints" Height="195"
                                          Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155"
                                          AllowDrop="True"
                                          PreviewMouseLeftButtonDown="LstPoints_PreviewMouseLeftButtonDown"
                                          PreviewMouseMove="LstPoints_PreviewMouseMove"
                                          Drop="LstPoints_Drop"
                                          SelectionChanged="LstPoints_SelectionChanged">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="گوشه" Width="46" DisplayMemberBinding="{Binding Label}"/>
                                            <GridViewColumn Header="X (Easting)" Width="105" DisplayMemberBinding="{Binding Easting, StringFormat={}{0:F3}}"/>
                                            <GridViewColumn Header="Y (Northing)" Width="112" DisplayMemberBinding="{Binding Northing, StringFormat={}{0:F3}}"/>
                                            <GridViewColumn Header="زون" Width="44" DisplayMemberBinding="{Binding ZoneDisplay}"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>

                                <WrapPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="▲ بالا" Click="BtnMoveUp_Click" Margin="0,0,4,4" Padding="8,4" FontSize="11"/>
                                    <Button Content="▼ پایین" Click="BtnMoveDown_Click" Margin="0,0,4,4" Padding="8,4" FontSize="11"/>
                                    <Button Content="🔄 مرتب‌سازی ساعتگرد" Click="BtnSortClockwise_Click" Margin="0,0,4,4" Padding="8,4" FontSize="11"/>
                                    <Button Content="🗑️ حذف انتخاب‌شده" Style="{StaticResource DangerButtonStyle}" Click="BtnDeletePoint_Click" Margin="0,0,4,4" Padding="8,4" FontSize="11"/>
                                    <Button Content="پاک‌سازی همه" Click="BtnClearPoints_Click" Margin="0,0,0,4" Padding="8,4" FontSize="11"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- کارت ۳: خلاصه متراژ، مساحت و جدول طول اضلاع -->
                        <Border Background="{StaticResource CardBgBrush}" CornerRadius="8" Padding="10" BorderBrush="#334155" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="خلاصه مساحت و طول اضلاع" FontWeight="Bold" FontSize="12.5" Foreground="#38BDF8" Margin="0,0,0,8"/>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#0F172A" CornerRadius="6" Padding="8" BorderBrush="#0284C7" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="مساحت واقعی زمین" FontSize="10.5" Foreground="#94A3B8"/>
                                            <TextBlock x:Name="TxtGroundArea" Text="0.00 m²" FontSize="14" FontWeight="Bold" Foreground="#38BDF8" FlowDirection="LeftToRight" HorizontalAlignment="Right"/>
                                            <TextBlock x:Name="TxtGroundHectares" Text="0.0000 هکتار" FontSize="10.5" Foreground="#CBD5E1"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Background="#0F172A" CornerRadius="6" Padding="8" BorderBrush="#334155" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="محیط کل محدوده" FontSize="10.5" Foreground="#94A3B8"/>
                                            <TextBlock x:Name="TxtPerimeter" Text="0.00 m" FontSize="14" FontWeight="Bold" Foreground="#10B981" FlowDirection="LeftToRight" HorizontalAlignment="Right"/>
                                            <TextBlock x:Name="TxtPlanarAreaSub" Text="مسطح UTM: 0.00 m²" FontSize="10" Foreground="#94A3B8"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <TextBlock x:Name="TxtScaleFactorInfo" Text="ضریب مقیاس UTM: 1.000000" FontSize="10.5" Foreground="#94A3B8" Margin="0,0,0,6"/>

                                <ListView x:Name="LstEdges" Height="150" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#334155">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="ضلع" Width="74" DisplayMemberBinding="{Binding EdgeName}"/>
                                            <GridViewColumn Header="فاصله واقعی (m)" Width="105" DisplayMemberBinding="{Binding GroundLengthMeters, StringFormat={}{0:N2}}"/>
                                            <GridViewColumn Header="فاصله مسطح (m)" Width="105" DisplayMemberBinding="{Binding PlanarLengthMeters, StringFormat={}{0:N2}}"/>
                                            <GridViewColumn Header="آزیموت" Width="62" DisplayMemberBinding="{Binding AzimuthDegrees, StringFormat={}{0:F1}°}"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#334155"/>

            <!-- بوم مرکزی نمایش DWG و نقاط -->
            <Grid Grid.Column="2">
                <ctrl:CadCanvasControl x:Name="CadCanvas"/>

                <!-- نشانگر کوچک ابزار فعال در گوشه بالا-راست بوم -->
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" Padding="10,5"
                        Background="#CC0F172A" CornerRadius="6" BorderBrush="#334155" BorderThickness="1">
                    <TextBlock x:Name="TxtActiveToolHint" Text="ابزار فعال: جابجایی نقشه (با اسکرول زوم کنید)" FontSize="11.5" Foreground="#E2E8F0"/>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch" Background="#334155"/>

            <!-- پنل چپ: مدیریت لایه‌های DWG و تنظیمات نمایش -->
            <Border Grid.Column="4" Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1,0,0,0" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="مدیریت لایه‌های نقشه (DWG)" FontWeight="Bold" FontSize="12.5" Foreground="#38BDF8" Margin="0,0,0,6"/>
                        <TextBlock x:Name="TxtLoadedCadFile" Text="هیچ فایل نقشه‌ای باز نشده است" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="همه روشن" Click="BtnAllLayersOn_Click" FontSize="11" Padding="6,3"/>
                            <Button Grid.Column="2" Content="همه خاموش" Click="BtnAllLayersOff_Click" FontSize="11" Padding="6,3"/>
                        </Grid>
                        <TextBox x:Name="TxtLayerSearch" TextChanged="TxtLayerSearch_TextChanged" ToolTip="جستجوی نام لایه..."/>
                    </StackPanel>

                    <ListBox x:Name="LstLayers" Grid.Row="1" Background="#0F172A" BorderBrush="#334155" Foreground="#F8FAFC">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="2">
                                    <CheckBox IsChecked="{Binding IsVisible}" Click="ChkLayerVisible_Click" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <Border Width="11" Height="11" CornerRadius="2" Background="{Binding ColorHex}" BorderBrush="#64748B" BorderThickness="0.6" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding EntityCount, StringFormat=' ({0})'}" VerticalAlignment="Center" FontSize="10.5" Foreground="#94A3B8" DockPanel.Dock="Left"/>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- تنظیمات سریع مهندسی -->
                    <Border Grid.Row="2" Background="{StaticResource CardBgBrush}" CornerRadius="8" Padding="8" Margin="0,10,0,0" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="تنظیمات نمایش و دقت" FontWeight="Bold" FontSize="12" Foreground="#38BDF8" Margin="0,0,0,6"/>
                            <CheckBox x:Name="ChkEnableSnap" Content="اسنپ دقیق روی گوشه‌ها (OSNAP)" IsChecked="True" Checked="SettingChanged" Unchecked="SettingChanged" Margin="0,0,0,4"/>
                            <CheckBox x:Name="ChkShowCadUnderlay" Content="نمایش نقشه DWG زیر کار" IsChecked="True" Checked="SettingChanged" Unchecked="SettingChanged" Margin="0,0,0,4"/>
                            <CheckBox x:Name="ChkShowDistances" Content="نمایش فاصله بین نقاط روی نقشه" IsChecked="True" Checked="SettingChanged" Unchecked="SettingChanged" Margin="0,0,0,4"/>
                            <CheckBox x:Name="ChkShowAngles" Content="نمایش زوایای داخلی گوشه‌ها" IsChecked="True" Checked="SettingChanged" Unchecked="SettingChanged" Margin="0,0,0,4"/>
                            <CheckBox x:Name="ChkUseGroundArea" Content="مساحت و طول واقعی زمین (ضریب UTM)" IsChecked="True" Checked="SettingChanged" Unchecked="SettingChanged" Margin="0,0,0,4"/>
                            <CheckBox x:Name="ChkFixShx" Content="اصلاح متون فارسی SHX قدیمی" IsChecked="True" Checked="SettingChanged" Unchecked="SettingChanged" Margin="0,0,0,4"/>
                            <CheckBox x:Name="ChkPersianDigits" Content="نمایش ارقام به صورت فارسی (۱۲۳)" IsChecked="False" Checked="SettingChanged" Unchecked="SettingChanged"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- نوار وضعیت پایین -->
        <Border Grid.Row="2" Background="#0B1120" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="0,1,0,0" Padding="12,5">
            <DockPanel>
                <TextBlock x:Name="TxtStatusCoordsUtm" Text="UTM: X = 0.000 , Y = 0.000" FontSize="11.5" Foreground="#38BDF8" FlowDirection="LeftToRight" Margin="0,0,18,0"/>
                <TextBlock x:Name="TxtStatusCoordsGeo" Text="Lat/Lon: 0.000000 , 0.000000" FontSize="11.5" Foreground="#A7F3D0" FlowDirection="LeftToRight" Margin="0,0,18,0"/>
                <TextBlock x:Name="TxtStatusSnap" Text="" FontSize="11.5" Foreground="#FACC15" Margin="0,0,18,0"/>
                <TextBlock x:Name="TxtStatusMeasure" Text="" FontSize="11.5" Foreground="#4ADE80" DockPanel.Dock="Left" HorizontalAlignment="Left"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
