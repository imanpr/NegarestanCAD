<Window x:Class="NegarestanCAD.Views.PrintPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="پیش‌نمایش و چاپ رسمی نقشه — نگارستان کَد"
        Height="820" Width="1360"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource VazirmatnFont}"
        Background="{StaticResource AppBgBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- پنل تنظیمات کارتوش و برگه چاپ -->
        <Border Grid.Column="0" Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                <StackPanel>
                    <TextBlock Text="تنظیمات برگه چاپ رسمی" FontSize="15" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,12"/>

                    <!-- سایز و جهت کاغذ -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="اندازه کاغذ" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3"/>
                            <ComboBox x:Name="CmbPaperSize" SelectionChanged="AnySettingChanged">
                                <ComboBoxItem Content="A4 (210 × 297 mm)" IsSelected="True"/>
                                <ComboBoxItem Content="A3 (297 × 420 mm)"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="جهت صفحه" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3"/>
                            <ComboBox x:Name="CmbOrientation" SelectionChanged="AnySettingChanged">
                                <ComboBoxItem Content="افقی (Landscape)" IsSelected="True"/>
                                <ComboBoxItem Content="عمودی (Portrait)"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!-- اطلاعات کارتوش -->
                    <TextBlock Text="اطلاعات کارتوش و مشخصات پروژه" FontWeight="Bold" FontSize="12.5" Foreground="#38BDF8" Margin="0,4,0,6"/>

                    <TextBlock Text="عنوان پروژه / نقشه" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBox x:Name="TxtProjectTitle" Margin="0,2,0,8" TextChanged="AnySettingChanged"/>

                    <TextBlock Text="نام مالک / متقاضی" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBox x:Name="TxtOwnerName" Margin="0,2,0,8" TextChanged="AnySettingChanged"/>

                    <TextBlock Text="شماره پلاک ثبتی / قطعه" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBox x:Name="TxtParcelNumber" Margin="0,2,0,8" TextChanged="AnySettingChanged"/>

                    <TextBlock Text="نشانی / موقعیت ملک" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBox x:Name="TxtLocation" Margin="0,2,0,8" TextChanged="AnySettingChanged"/>

                    <TextBlock Text="نام مهندس / شرکت مشاور" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBox x:Name="TxtEngineer" Margin="0,2,0,8" TextChanged="AnySettingChanged"/>

                    <TextBlock Text="شماره پروانه / عضویت نظام مهندسی" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBox x:Name="TxtLicense" Margin="0,2,0,8" TextChanged="AnySettingChanged"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="تاریخ شمسی" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBox x:Name="TxtShamsiDate" Margin="0,2,0,0" TextChanged="AnySettingChanged"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="مقیاس دلخواه (اختیاری)" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBox x:Name="TxtScaleOverride" Margin="0,2,0,0" ToolTip="مثلاً 1:500" TextChanged="AnySettingChanged"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="توضیحات تکمیلی" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBox x:Name="TxtNotes" Height="52" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,2,0,10" TextChanged="AnySettingChanged"/>

                    <!-- آپلود لوگو -->
                    <DockPanel Margin="0,0,0,12">
                        <Button Content="🖼️ انتخاب لوگو" Click="BtnBrowseLogo_Click" DockPanel.Dock="Right" Margin="0,0,6,0"/>
                        <Button Content="حذف لوگو" Click="BtnClearLogo_Click" DockPanel.Dock="Left"/>
                        <TextBlock x:Name="TxtLogoFile" Text="بدون لوگو" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" Margin="6,0"/>
                    </DockPanel>

                    <!-- گزینه‌های نمایش روی چاپ -->
                    <TextBlock Text="اجزای نمایش‌داده‌شده در برگه" FontWeight="Bold" FontSize="12.5" Foreground="#38BDF8" Margin="0,2,0,6"/>
                    <CheckBox x:Name="ChkIncludeDwg" Content="نمایش لایه نقشه DWG زیر کار" Margin="0,0,0,5" Checked="AnySettingChanged" Unchecked="AnySettingChanged"/>
                    <CheckBox x:Name="ChkGrayscaleDwg" Content="رنگ خاکستری ملایم برای زیرکار DWG" Margin="0,0,0,5" Checked="AnySettingChanged" Unchecked="AnySettingChanged"/>
                    <CheckBox x:Name="ChkShowDistances" Content="نمایش طول اضلاع روی نقشه" Margin="0,0,0,5" Checked="AnySettingChanged" Unchecked="AnySettingChanged"/>
                    <CheckBox x:Name="ChkShowCoordTable" Content="جدول مختصات گوشه‌ها (UTM و Lat/Lon)" Margin="0,0,0,5" Checked="AnySettingChanged" Unchecked="AnySettingChanged"/>
                    <CheckBox x:Name="ChkShowEdgeTable" Content="جدول طول اضلاع و آزیموت" Margin="0,0,0,14" Checked="AnySettingChanged" Unchecked="AnySettingChanged"/>

                    <!-- دکمه‌های خروجی چاپ -->
                    <Button Content="🖨️ چاپ رسمی / ذخیره PDF" Style="{StaticResource SuccessButtonStyle}" Height="38" FontSize="13" Click="BtnPrintNow_Click" Margin="0,0,0,8"/>
                    <Button Content="🖼️ ذخیره تصویر باکیفیت 300 DPI (PNG)" Style="{StaticResource PrimaryButtonStyle}" Height="34" Click="BtnExportPng_Click"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- پیش‌نمایش زنده برگه -->
        <Grid Grid.Column="1" Background="#1E293B">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="24">
                <Viewbox Stretch="Uniform" MaxWidth="1060">
                    <Border x:Name="PreviewHost" Background="White">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="22" ShadowDepth="6" Opacity="0.45" Color="Black"/>
                        </Border.Effect>
                    </Border>
                </Viewbox>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
